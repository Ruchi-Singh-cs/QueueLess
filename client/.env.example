# Maps: leave empty to use the free OpenStreetMap provider (no key, no billing).
# Set a key to use Google Maps Platform instead (Maps JavaScript API + Places API (New)); restrict it to your domains.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for cloud-based map styling (defaults to DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=
