# Copy to server/.env and fill in. Never commit .env itself.

PORT=4000
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/queueless?retryWrites=true&w=majority
#                                 # unset -> embedded db in server/data (dev only; unavailable in production installs)
# NODE_ENV=production             # set by Docker; makes a missing MONGO_URI a startup error instead of a fallback
JWT_SECRET=                       # long random string, e.g. openssl rand -hex 32 — the server refuses to start in production without it
# TRUST_PROXY=1                   # behind nginx / a tunnel / a load balancer, so rate limits see the real client IP
ADMIN_EMAIL=admin@example.com     # registering with this email yields role=admin

# Web push. Generate a pair with: npm run vapid. Blank -> push reported as unavailable, app still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Razorpay (express slots). Blank -> the feature is hidden. Use rzp_test_* keys from dashboard.razorpay.com while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AUTO_APPROVE_SHOPS=1            # new shops go live without admin approval (default: pending)
# SEED=1                          # seed sample shops + accounts on every start (idempotent)

# Sample-data city for npm run seed
SEED_LAT=26.8492
SEED_LNG=80.8586
SEED_CITY=Lucknow
SEED_STATE=Uttar Pradesh
SEED_PINCODE=226001
SEED_EXTRA=100                    # generated shops on top of the 22 named ones (0 = none)
SEED_RADIUS_KM=60
