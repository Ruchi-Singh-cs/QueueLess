# Copy to server/.env and fill in. Never commit .env itself.

PORT=
# MongoDB Atlas (URL-encode special characters in the password, e.g. @ → %40).
# Unset/comment out to fall back to the embedded local db in server/data.
# Disabled: this machine's IP is not on the Atlas Access List, so the TLS handshake is refused.
# Re-enable by deleting the "# " below, after Atlas > Network Access > Add Current IP Address.
# MONGO_URI=mongodb+srv://aryans8095_db_user:WsdxSqthPv4RWiFy@cluster0.kzt4uv8.mongodb.net/queueless?appName=Cluster0
JWT_SECRET=
ADMIN_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Demo city: where npm run seed / npm run demo place the shops
SEED_LAT=
SEED_LNG=
SEED_CITY=
SEED_STATE=
SEED_PINCODE=
SEED_EXTRA=
SEED_RADIUS_KM=