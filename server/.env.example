PORT=4000
# MONGO_URI=mongodb://127.0.0.1:27017/queueless   # unset -> embedded db in server/data (dev only)
# NODE_ENV=production            # set by Docker/Render; makes a missing MONGO_URI a startup error instead of a fallback
JWT_SECRET=change-me            # use a long random string in production, e.g. openssl rand -hex 32
# TRUST_PROXY=1                 # set when behind nginx/Caddy/a load balancer so rate limits see the real client IP
ADMIN_EMAIL=admin@example.com   # registering with this email yields role=admin

# Web push. Generate a pair with: npm run vapid. Blank -> push reported as unavailable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AUTO_APPROVE_SHOPS=1   # new shops go live without admin approval (default: pending)
# DEMO=1                 # stage the full demo on every boot (Render); SEED=1 seeds shops only

# Demo city for npm run seed / npm run demo
SEED_LAT=26.8492
SEED_LNG=80.8586
SEED_CITY=Lucknow
SEED_STATE=Uttar Pradesh
SEED_PINCODE=226001
SEED_EXTRA=100          # generated shops on top of the 22 named ones (0 = none)
SEED_RADIUS_KM=60
